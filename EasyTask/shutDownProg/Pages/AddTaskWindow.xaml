<ui:FluentWindow x:Class="EasyTask.Pages.AddTaskWindow"  
         xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  FlowDirection="{DynamicResource FlowAll}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 
                 xmlns:Language="clr-namespace:EasyTask.Properties.Languages"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"  Width="1024" Height="600"
        xmlns:local="clr-namespace:EasyTask.Pages" x:Name="AddTaskWindows"         mc:Ignorable="d" WindowStyle="None"
        Title="Create Task"  MinHeight="600" MinWidth="550" Background="{DynamicResource ATWDarkOrWhiteColor}" Icon="/files/1080LOGO/Original.png" SizeChanged="Window_SizeChanged" KeyDown="AddTaskWindows_KeyDown">
    <ui:FluentWindow.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary x:Name="addTaskBanner" Source="..\files\icons\addtaskBanner\addTaskBanner.xaml"/>
                <ResourceDictionary x:Name="TopElmOfWelcome" Source="..\files\icons\WelcomeElement\TopElmOfWelcome.xaml"/>
                <ResourceDictionary x:Name="BottomElmOfWelcome" Source="..\files\icons\WelcomeElement\BottomElmOfWelcome.xaml"/>
                <ResourceDictionary x:Name="plusElm" Source="..\files\icons\WelcomeElement\PlusElm.xaml"/>
                <ResourceDictionary x:Name="TaskNameBanner" Source="..\files\icons\TaskNameBanner\TaskNameBanner.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Storyboard x:Key="In" x:Name="In" Completed="In_Completed">

                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TasksRibbon" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="1">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="TasksRibbon" Storyboard.TargetProperty="(FrameworkElement.Margin)">

                    <EasingThicknessKeyFrame KeyTime="00:00:00.3000000" Value="30,30,0,0"/>
                </ThicknessAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="Out" x:Name="Out" Completed="Out_Completed">


                <!--ForTaskRibbonHide-->
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TasksRibbon" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00.0000000" Value="1">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="TasksRibbon" Storyboard.TargetProperty="(FrameworkElement.Margin)">

                    <EasingThicknessKeyFrame KeyTime="00:00:00.3000000" Value="-242,30,0,0"/>
                </ThicknessAnimationUsingKeyFrames>



            </Storyboard>

        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    <Grid x:Name="All_content" Background="{DynamicResource ATWDarkOrWhiteColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid x:Name="NextButtonElementGrid" Visibility="Visible" HorizontalAlignment="Right" Height="50" Grid.Row="1" VerticalAlignment="Bottom" Width="170" Margin="0,0,30,30">
            <Button x:Name="btn" Style="{DynamicResource AddtaskButtonStyle}" Content="{x:Static Language:Lang.DefaultTextName_Next}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="70,0,0,0" Click="btn_Click" TabIndex="1" />
            <Button x:Name="ATWBack" Style="{DynamicResource AddtaskSecendryButton}" Content="{x:Static Language:Lang.DefaultTextName_Back}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="65" Click="Button_Click" TabIndex="2"/>

        </Grid>

        <DockPanel  x:Name="Add_task"  Grid.Row="1" d:IsHidden="False">

            <StackPanel x:Name="TasksRibbon" HorizontalAlignment="Left" Orientation="Vertical" VerticalAlignment="Top" Margin="30,30,0,0" >
                <StackPanel.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </StackPanel.RenderTransform>
                <TextBlock x:Name="TitleOfTasks" Text="{x:Static Language:Lang.AddTaskWindow_CreateTaskMainText}" FontWeight="SemiBold" Foreground="{DynamicResource ATWDarkOrWhiteColorRep}" Style="{DynamicResource BoldTextBlock}" Margin="0,0,0,20" />
                <Grid Height="31" Width="207">

                    <Grid x:Name="TrueProssesGridStep1" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="-2,0,0,0" Visibility="Visible" Width="20" Height="20"  >
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <Grid RenderTransformOrigin="0.5,0.5" >
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Rectangle  HorizontalAlignment="Left" RadiusX="1" RadiusY="1" Height="7" VerticalAlignment="Top" Width="3" Fill="{DynamicResource ATWElpsColor}"  Margin="1.70,10.5,0,0">
                                <Rectangle.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform Angle="-45"/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle HorizontalAlignment="Left" Height="15" VerticalAlignment="Center" Width="3.5" Fill="{DynamicResource ATWElpsColor}"  RadiusX="1" RadiusY="1" Margin="15,0,0,0">
                                <Rectangle.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform Angle="45"/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Grid>
                    <Ellipse FlowDirection="LeftToRight" x:Name="SetDateElp" Height="15" Stroke="{DynamicResource ATWElpsColor}" Width="15" HorizontalAlignment="Left" VerticalAlignment="Center" StrokeThickness="2"/>
                    <Label x:Name="SetDateLabel" Content="{x:Static Language:Lang.AddTaskWindow_SetDateMainText}" FontWeight="SemiBold" Style="{DynamicResource Normal text}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"/>
                </Grid>
                <Grid Height="31" Width="207">
                    <Grid x:Name="TrueProssesGridStep2" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="-2,0,0,0" Visibility="Visible" Width="20" Height="20" >
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <Grid RenderTransformOrigin="0.5,0.5" >
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Rectangle  HorizontalAlignment="Left" RadiusX="1" RadiusY="1" Height="7" VerticalAlignment="Top" Width="3" Fill="{DynamicResource ATWElpsColor}"  Margin="1.70,10.5,0,0">
                                <Rectangle.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform Angle="-45"/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle HorizontalAlignment="Left" Height="15" VerticalAlignment="Center" Width="3.5" Fill="{DynamicResource ATWElpsColor}"  RadiusX="1" RadiusY="1" Margin="15,0,0,0">
                                <Rectangle.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform Angle="45"/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Grid>
                    <Ellipse FlowDirection="LeftToRight" x:Name="SetTimeElp" Height="15" Stroke="{DynamicResource ATWElpsColor}" Width="15" HorizontalAlignment="Left" VerticalAlignment="Center" StrokeThickness="2"/>
                    <Label x:Name="SetTimeLabel" Content="{x:Static Language:Lang.AddTaskWindow_SetTimeMainText}" Style="{DynamicResource Normal text}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"/>
                </Grid>
                <Grid Height="31" Width="207" >
                    <Grid x:Name="TrueProssesGridStep3" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="-2,0,0,0" Visibility="Visible" Width="20" Height="20"  >
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <Grid RenderTransformOrigin="0.5,0.5" >
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Rectangle  HorizontalAlignment="Left" RadiusX="1" RadiusY="1" Height="7" VerticalAlignment="Top" Width="3" Fill="{DynamicResource ATWElpsColor}"  Margin="1.70,10.5,0,0">
                                <Rectangle.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform Angle="-45"/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle HorizontalAlignment="Left" Height="15" VerticalAlignment="Center" Width="3.5" Fill="{DynamicResource ATWElpsColor}"  RadiusX="1" RadiusY="1" Margin="15,0,0,0">
                                <Rectangle.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform Angle="45"/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Grid>
                    <Ellipse FlowDirection="LeftToRight" x:Name="SetActionElp" Height="15" Stroke="{DynamicResource ATWElpsColor}" Width="15" HorizontalAlignment="Left" VerticalAlignment="Center" StrokeThickness="2"/>
                    <Label x:Name="SetActionLabel" Content="{x:Static Language:Lang.AddTaskWindow_SetActionMainText}" Style="{DynamicResource Normal text}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"/>
                </Grid>
                <Grid Height="31" Width="207">
                    <Grid x:Name="TrueProssesGridStep4" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="-2,0,0,0" Visibility="Visible" Width="20" Height="20"  >
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <Grid RenderTransformOrigin="0.5,0.5" >
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Rectangle  HorizontalAlignment="Left" RadiusX="1" RadiusY="1" Height="7" VerticalAlignment="Top" Width="3" Fill="{DynamicResource ATWElpsColor}"  Margin="1.70,10.5,0,0">
                                <Rectangle.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform Angle="-45"/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle HorizontalAlignment="Left" Height="15" VerticalAlignment="Center" Width="3.5" Fill="{DynamicResource ATWElpsColor}"  RadiusX="1" RadiusY="1" Margin="15,0,0,0">
                                <Rectangle.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform Angle="45"/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Grid>
                    <Ellipse FlowDirection="LeftToRight" x:Name="SetTaskNameElp" Height="15" Stroke="{DynamicResource ATWElpsColor}" Width="15" HorizontalAlignment="Left" VerticalAlignment="Center" StrokeThickness="2"/>
                    <Label x:Name="SetTaskNameLabel" Content="{x:Static Language:Lang.AddTaskWindow_SetTaskNameMainText}" Style="{DynamicResource Normal text}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"/>
                </Grid>
            </StackPanel>
            <Border  x:Name="Allsteps" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderThickness="1" MinHeight="350" MinWidth="450" Background="{DynamicResource ATWSecColor}" CornerRadius="5" Margin="30,30,30,150">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Grid x:Name="AllStepsGrid">

                    <Border x:Name="Step1" BorderBrush="Transparent" BorderThickness="0" d:IsHidden="True">
                        <Grid x:Name="Step1_Grid">
                            <TextBlock x:Name="EnterDateS1" Text="{x:Static Language:Lang.S1AddTaskWindow_EnterDate}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource BoldTextBlock}" Foreground="{DynamicResource ATWDarkOrWhiteColorRep}" Margin="0,0,0,250"/>
                            <StackPanel FlowDirection="LeftToRight" HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Height="136" Width="100" Margin="0,0,15,0">
                                    <Ellipse Visibility="Visible" x:Name="yearRecTextS1" HorizontalAlignment="Center"  Height="100"  VerticalAlignment="Top" Width="100" StrokeThickness="10"/>
                                    <Label x:Name="yearTextS1" Content="{x:Static Language:Lang.S1AddTaskWindow_Year}" Style="{DynamicResource Normal text}"   HorizontalAlignment="Center" Margin="0,105,0,0" VerticalAlignment="Top"/>

                                   
                                    <TextBox x:Name="yearBoxS1"  FlowDirection="{DynamicResource FlowAll}" Style="{DynamicResource ForValueOfDate}" Text="0000" Width="100" HorizontalAlignment="Center"  VerticalAlignment="Top" Height="100" TextWrapping="NoWrap" MaxLength="4"    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" LostFocus="yearBoxS1_LostFocus" />
                                </Grid>
                                <Grid Height="136" Margin="15,0,15,0">
                                    <Ellipse x:Name="dayRecTextS1" HorizontalAlignment="Left"  Height="100"  VerticalAlignment="Top" Width="100" StrokeThickness="10"/>
                                    <Label x:Name="dayTextS1" Content="{x:Static Language:Lang.S1AddTaskWindow_Day}" Style="{DynamicResource Normal text}"   HorizontalAlignment="Center" Margin="0,105,0,0" VerticalAlignment="Top"/>
                                    <TextBox x:Name="dayBoxS1"  FlowDirection="{DynamicResource FlowAll}" Style="{DynamicResource ForValueOfDate}" Text="00" Width="100" HorizontalAlignment="Left" VerticalAlignment="Top" Height="100" TextWrapping="NoWrap" MaxLength="2"      HorizontalContentAlignment="Center" VerticalContentAlignment="Center" LostFocus="dayBoxS1_LostFocus" />
                                </Grid>
                                <Grid Height="136" Margin="15,0,0,0">
                                    <Ellipse x:Name="monthRecTextS1" HorizontalAlignment="Center"  Height="100" VerticalAlignment="Top" Width="100" StrokeThickness="10"/>
                                    <Label x:Name="monthTextS1" Content="{x:Static Language:Lang.S1AddTaskWindow_Month}" Style="{DynamicResource Normal text}"   HorizontalAlignment="Center" Margin="0,105,0,0" VerticalAlignment="Top"/>
                                    <TextBox x:Name="monthBoxS1"  FlowDirection="{DynamicResource FlowAll}"  Style="{DynamicResource ForValueOfDate}" Text="00" Width="100" HorizontalAlignment="Center" VerticalAlignment="Top" Height="100" TextWrapping="NoWrap" MaxLength="2"   HorizontalContentAlignment="Center" VerticalContentAlignment="Center" LostFocus="monthBoxS1_LostFocus" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="Step2" BorderThickness="1" Visibility="Visible" d:IsHidden="True">
                        <Grid x:Name="Step2_Grid" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{x:Static Language:Lang.S2AddTaskWindow_EnterTime}" HorizontalAlignment="Center" VerticalAlignment="Top" Style="{DynamicResource BoldTextBlock}" Foreground="{DynamicResource ATWDarkOrWhiteColorRep}" Margin="0,0,0,250"/>
                            <StackPanel FlowDirection="LeftToRight" HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Height="136" Margin="0,0,15,0">
                                    <Ellipse x:Name="hourElpS2" HorizontalAlignment="Left"  Height="100"  VerticalAlignment="Top" Width="100" StrokeThickness="10"/>
                                    <Label x:Name="hourTextS2" Content="{x:Static Language:Lang.S2AddTaskWindow_Hour}" Style="{DynamicResource Normal text}" Foreground="{DynamicResource ATWDarkOrWhiteColorRep}"  HorizontalAlignment="Left" Margin="27,105,0,0" VerticalAlignment="Top"/>
                                    <TextBox  FlowDirection="{DynamicResource FlowAll}" x:Name="hourBoxS2" Style="{DynamicResource ForValueOfDate}"   Text="00" Width="100" HorizontalAlignment="Center" VerticalAlignment="Top" Height="100"   Foreground="{DynamicResource ATWDarkOrWhiteColorRep}"  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"  LostFocus="hourBoxS2_LostFocus" KeyUp="AllTextBoxesKeyUp"/>
                                </Grid>
                                <Grid Height="45" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,30,0,0">
                                    <Ellipse HorizontalAlignment="Center" Fill="{DynamicResource ATWBColor}" Height="10" VerticalAlignment="Top" Width="10"/>
                                    <Ellipse HorizontalAlignment="Center" Fill="{DynamicResource ATWBColor}" Height="10" Margin="0,35,0,0" VerticalAlignment="Top" Width="10"/>
                                </Grid>
                                <Grid Height="136" Width="100" Margin="15,0,0,0">
                                    <Ellipse x:Name="minuteElpS2" HorizontalAlignment="Center"  Height="100"  VerticalAlignment="Top" Width="100" StrokeThickness="10"/>
                                    <TextBox  FlowDirection="{DynamicResource FlowAll}" x:Name="minuteBoxS2"  Style="{DynamicResource ForValueOfDate}" Text="00" Width="100" HorizontalAlignment="Center" VerticalAlignment="Top" Height="100"  MaxLength="2"  Foreground="{DynamicResource ATWDarkOrWhiteColorRep}"  HorizontalContentAlignment="Center" VerticalContentAlignment="Center" LostFocus="minuteBoxS2_LostFocus" KeyUp="AllTextBoxesKeyUp"/>
                                    <Label x:Name="minuteTextS2" Content="{x:Static Language:Lang.S2AddTaskWindow_Minute}" Style="{DynamicResource Normal text}" Foreground="{DynamicResource ATWDarkOrWhiteColorRep}"  HorizontalAlignment="Center" Margin="0,105,0,0" VerticalAlignment="Top"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="Step3" BorderThickness="1" Visibility="Visible">
                        <Grid x:Name="Step3_Grid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{x:Static Language:Lang.S3AddTaskWindow_EnterAction}" Style="{DynamicResource BoldTextBlock}" Foreground="{DynamicResource ATWDarkOrWhiteColorRep}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,100"/>
                                <ScrollViewer x:Name="EnterActionScroll" Grid.Row="1" Foreground="{x:Null}" MaxHeight="140" VerticalAlignment="Top" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Center"  >
                                    <Grid VerticalAlignment="Top" HorizontalAlignment="Center">
                                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Top" Margin="25,0,0,0">
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,15,0">
                                                <ToggleButton x:Name="ShutDownBtn" Style="{DynamicResource SecoundButton}" IsChecked="{Binding ShutDownBtnBool, ElementName=AddTaskWindows}" Content="{x:Static Language:Lang.S3AddTaskWindow_ShutDown}" Height="50" HorizontalAlignment="Left" VerticalAlignment="Top" Width="114" Checked="ActionsButtonChecked" Unchecked="ActionsButtonUnChecked"/>
                                            </Grid>
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15,0,15,0">
                                                <ToggleButton x:Name="RestartBtn" Style="{DynamicResource SecoundButton}"   IsChecked="{Binding RestartBtnBool, ElementName=AddTaskWindows}" Content="{x:Static Language:Lang.S3AddTaskWindow_ReStart}" Height="50"  HorizontalAlignment="Left" VerticalAlignment="Top" Width="114" Checked="ActionsButtonChecked"  Unchecked="ActionsButtonUnChecked"/>
                                            </Grid>
                                            <Grid HorizontalAlignment="Center"  VerticalAlignment="Center" Margin="15,0,0,0">
                                                <ToggleButton x:Name="SleepBtn"  IsChecked="{Binding SleepBtnBool, ElementName=AddTaskWindows}" Content="{x:Static Language:Lang.S3AddTaskWindow_Sleep}" Height="50" Style="{DynamicResource SecoundButton}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="114" Checked="ActionsButtonChecked"  Unchecked="ActionsButtonUnChecked"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Top" Margin="25,150,0,0">
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,15,0">
                                                <ToggleButton x:Name="OpenFileBtn" Style="{DynamicResource SecoundButton}" IsChecked="{Binding OpenFileBtnBool, ElementName=AddTaskWindows}" Content="{x:Static Language:Lang.S3AddTaskWindow_OpenFile}" Height="50" HorizontalAlignment="Left" VerticalAlignment="Top" Width="150" Checked="ActionsButtonChecked" Unchecked="ActionsButtonUnChecked"/>
                                            </Grid>
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15,0,0,0">
                                                <ToggleButton x:Name="KillAppBtn" Style="{DynamicResource SecoundButton}"   IsChecked="{Binding KillAppBtnBool, ElementName=AddTaskWindows}" Content="{x:Static Language:Lang.S3AddTaskWindow_KillApp}" Height="50"  HorizontalAlignment="Left" VerticalAlignment="Top" Width="150" Checked="ActionsButtonChecked"  Unchecked="ActionsButtonUnChecked"/>
                                            </Grid>

                                        </StackPanel>
                                        <Button x:Name="MoreBtn"  HorizontalAlignment="Center" VerticalAlignment="Top" Width="50" Height="50" Margin="25,80,0,0" Click="MoreBtn_Click">
                                            <Button.Template>
                                                <ControlTemplate>

                                                    <Grid x:Name="MoreIcon" HorizontalAlignment="Center" Height="60" Margin="0,0,0,0" VerticalAlignment="Center">
                                                        <Border Background="{DynamicResource ATWSecColor}"/>
                                                        <Grid Height="42" Width="16" RenderTransformOrigin="0.5,0.5" Margin="0,0,0,10" >
                                                            <Grid.RenderTransform>
                                                                <TransformGroup>
                                                                    <ScaleTransform/>
                                                                    <SkewTransform/>
                                                                    <RotateTransform Angle="45"/>
                                                                    <TranslateTransform/>
                                                                </TransformGroup>
                                                            </Grid.RenderTransform>
                                                            <Rectangle HorizontalAlignment="Left" Height="16" Margin="6,5,0,0" VerticalAlignment="Top" Width="2" RenderTransformOrigin="0.5,0.5" Fill="{DynamicResource ATWMainColor}" RadiusX="1" RadiusY="1">
                                                                <Rectangle.RenderTransform>
                                                                    <TransformGroup>
                                                                        <ScaleTransform/>
                                                                        <SkewTransform/>
                                                                        <RotateTransform Angle="0"/>
                                                                        <TranslateTransform/>
                                                                    </TransformGroup>
                                                                </Rectangle.RenderTransform>
                                                            </Rectangle>
                                                            <Rectangle HorizontalAlignment="Left" Height="15" Margin="-0.5,12.5,0,0" VerticalAlignment="Top" Width="2" RenderTransformOrigin="0.5,0.5" RadiusX="1" RadiusY="1" Fill="{DynamicResource ATWMainColor}">
                                                                <Rectangle.RenderTransform>
                                                                    <TransformGroup>
                                                                        <ScaleTransform/>
                                                                        <SkewTransform/>
                                                                        <RotateTransform Angle="-90"/>
                                                                        <TranslateTransform/>
                                                                    </TransformGroup>
                                                                </Rectangle.RenderTransform>
                                                            </Rectangle>
                                                        </Grid>
                                                        <Grid Height="42" Width="16" RenderTransformOrigin="0.5,0.5" Margin="0,10,0,0" >
                                                            <Grid.RenderTransform>
                                                                <TransformGroup>
                                                                    <ScaleTransform/>
                                                                    <SkewTransform/>
                                                                    <RotateTransform Angle="45"/>
                                                                    <TranslateTransform/>
                                                                </TransformGroup>
                                                            </Grid.RenderTransform>
                                                            <Rectangle HorizontalAlignment="Left" Height="16" Margin="6,5,0,0" VerticalAlignment="Top" Width="2" RenderTransformOrigin="0.5,0.5" Fill="{DynamicResource ATWMainColor}" RadiusX="1" RadiusY="1">
                                                                <Rectangle.RenderTransform>
                                                                    <TransformGroup>
                                                                        <ScaleTransform/>
                                                                        <SkewTransform/>
                                                                        <RotateTransform Angle="0"/>
                                                                        <TranslateTransform/>
                                                                    </TransformGroup>
                                                                </Rectangle.RenderTransform>
                                                            </Rectangle>
                                                            <Rectangle HorizontalAlignment="Left" Height="15" Margin="-0.5,12.5,0,0" VerticalAlignment="Top" Width="2" RenderTransformOrigin="0.5,0.5" RadiusX="1" RadiusY="1" Fill="{DynamicResource ATWMainColor}">
                                                                <Rectangle.RenderTransform>
                                                                    <TransformGroup>
                                                                        <ScaleTransform/>
                                                                        <SkewTransform/>
                                                                        <RotateTransform Angle="-90"/>
                                                                        <TranslateTransform/>
                                                                    </TransformGroup>
                                                                </Rectangle.RenderTransform>
                                                            </Rectangle>
                                                        </Grid>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                    </Grid>

                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border x:Name="Step4" BorderThickness="1" Visibility="Visible" d:IsHidden="True">
                        <Grid x:Name="Step2_Grid2" >
                            <Image Source="{DynamicResource TaskNameBannerDrawingImage}" />
                            <TextBlock Text="{x:Static Language:Lang.S4AddTaskWindow_EnterTaskName}" VerticalAlignment="Center" Style="{DynamicResource BoldTextBlock}" Foreground="{DynamicResource ATWDarkOrWhiteColorRep}" HorizontalAlignment="Center" Margin="0,0,0,250"/>
                            <TextBox x:Name="TaskNameBoxS4"   HorizontalAlignment="Center" Text="{x:Static Language:Lang.S4AddTaskWindow_DefaultTaskName}" MaxLength="18" VerticalAlignment="Center" Width="295" Style="{DynamicResource ForValueOfName}" Height="41" Background="{DynamicResource ATWDarkOrWhiteColor}" Padding="15,0,0,0" Margin="0,0,0,50" KeyUp="AllTextBoxesKeyUp"/>

                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </DockPanel>
        <ui:TitleBar 
     x:Name="TitleBar"
     Title="{Binding ViewModel.ApplicationTitle}" ButtonsForeground="{DynamicResource RibbonBarButtonsForegroundColor}"
     Grid.Row="0" Background="{DynamicResource ATWDarkOrWhiteColor}"
     CloseWindowByDoubleClickOnIcon="True"  Margin="0,0,0,0">
            <ui:TitleBar.Icon>
                <ui:ImageIcon  />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
    </Grid>
</ui:FluentWindow>
