<UserControl x:Class="EasyTask.Pages.Element.TasksShort"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EasyTask.Pages.Element"
      mc:Ignorable="d" x:Name="TasksShortX"
     
      >

    <Grid Margin="5">
        <TextBlock Text="{Binding TaskName , ElementName=TasksShortX}" HorizontalAlignment="Left" FontSize="12" VerticalAlignment="Center"></TextBlock>
        <TextBlock Text="{Binding TaskTime , ElementName=TasksShortX }" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"></TextBlock>
    </Grid>
</UserControl>
