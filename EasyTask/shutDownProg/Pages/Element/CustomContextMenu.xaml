<ContextMenu x:Class="EasyTask.Pages.Element.CustomContextMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EasyTask.Pages.Element" Background="{DynamicResource TaskbarIconStyleSec}"
        mc:Ignorable="d" Width="250" >
    <ContextMenu.Template>
        <ControlTemplate TargetType="ContextMenu">
            <local:CustomMenuItem></local:CustomMenuItem>
        </ControlTemplate>
    </ContextMenu.Template>
</ContextMenu>
