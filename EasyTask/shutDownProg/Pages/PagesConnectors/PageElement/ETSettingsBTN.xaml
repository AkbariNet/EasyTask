<Button x:Class="EasyTask.Pages.PagesConnectors.PageElement.ETSettingsBTN"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EasyTask.Pages.PagesConnectors.PageElement"
             mc:Ignorable="d" x:Name="ETSBTN" Margin="15,5,5,5"
             Height="40" Width="auto" >
    <Button.Template>
        <ControlTemplate>

            <Border Background="{Binding Path=Background, ElementName=ETSBTN}"  BorderThickness="0" CornerRadius="3">
                <Button Click="Button_Click" Foreground="{Binding Path=Foreground, ElementName=ETSBTN}" Margin="30,0,30,0" >
                    <Button.Template>
                        <ControlTemplate>
                            <TextBlock Text="{Binding ElementName=ETSBTN, Path=SetContent}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{TemplateBinding Property=Foreground }"/>
                        </ControlTemplate>
                    </Button.Template>

                </Button>
            </Border>
        </ControlTemplate>
    </Button.Template>
</Button>
