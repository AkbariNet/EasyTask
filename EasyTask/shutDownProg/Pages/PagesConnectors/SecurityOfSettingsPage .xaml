<UserControl
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"   
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="SecurityOfSettingsPageX"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" FlowDirection="{DynamicResource FlowAll}"
      xmlns:local="clr-namespace:EasyTask.Pages" 
                 xmlns:Language="clr-namespace:EasyTask.Properties.Languages"
              xmlns:PageElement="clr-namespace:EasyTask.Pages.PagesConnectors.PageElement" x:Class="EasyTask.Pages.PagesConnectors.SecurityOfSettingsPage" 
              HorizontalAlignment="Left" VerticalAlignment="Top" Loaded="SecurityOfSettingsPageX_Loaded">
    <UserControl.RenderTransform>
        <TransformGroup>
            <ScaleTransform/>
            <SkewTransform/>
            <RotateTransform/>
            <TranslateTransform/>
        </TransformGroup>
    </UserControl.RenderTransform>
    <Grid Margin="40,20,0,0">

        <TextBlock Text="{x:Static Language:Lang.SecurityBTN}" Style="{DynamicResource SWPBoldTextBlock}" VerticalAlignment="Top" HorizontalAlignment="Left"/>

        <ScrollViewer Margin="0,70,0,10">
            <StackPanel Orientation="Vertical">
                <PageElement:ETBeginOfTab ETBlabelContent="{x:Static Language:Lang.Security_LockMode}"/>
                <PageElement:ETCheckBox x:Name="EnbLockBox" Click="EnbLockBox_Click" Content="{x:Static Language:Lang.DefaultTextName_Enable}" IsChecked="{Binding SWSEnbLockApp ,Mode=OneWay}"  HorizontalAlignment="Left" />
                <StackPanel Orientation="Vertical" x:Name="LockModeSubButton" >
                    <PageElement:ETCheckBox  Content="{x:Static Language:Lang.Security_CantAddTaskWhenLockedAppProperty}" IsChecked="{Binding SWSCantAddTaskWhenLocked ,Mode=TwoWay}"  HorizontalAlignment="Left" />
                    <PageElement:ETComboBox ComboIntExport="{Binding SWSRunWhenSecurityAlert ,Mode=TwoWay}" ContentOfMainLabel="{x:Static Language:Lang.Security_InCaseOfRiskOfPenetrationProperty}"  btnContent1="ShutDown"  btnContent2="Sleep" btnContent3="Restart"   HorizontalAlignment="Left" ></PageElement:ETComboBox>
                    <Button x:Name="SWSChangePassowrdButton"   HorizontalAlignment="Left" Click="SWSChangePassowrdButton_Click">
                        <Button.Template>
                            <ControlTemplate>
                                <PageElement:ETSettingsBTN SetContent="{x:Static Language:Lang.DefaultTextName_ChangePassword}" Background="{DynamicResource BorderBrushForDifficultColorElements}" Foreground="White"></PageElement:ETSettingsBTN>

                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                <PageElement:ETEndingOfTab Width="250" HorizontalAlignment="Left"></PageElement:ETEndingOfTab>
                    
            </StackPanel>

        </ScrollViewer>
    </Grid>
</UserControl>
