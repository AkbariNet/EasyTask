<UserControl
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="{DynamicResource FlowAll}"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" x:Name="TaskOfSettingsPageX"
      xmlns:local="clr-namespace:EasyTask.Pages" 
                 xmlns:Language="clr-namespace:EasyTask.Properties.Languages"
              xmlns:PageElement="clr-namespace:EasyTask.Pages.PagesConnectors.PageElement" x:Class="EasyTask.Pages.PagesConnectors.TaskOfSettingsPage" 
              HorizontalAlignment="Left" VerticalAlignment="Top" Loaded="TaskOfSettingsPageX_Loaded">
    <UserControl.RenderTransform>
        <TransformGroup>
            <ScaleTransform/>
            <SkewTransform/>
            <RotateTransform/>
            <TranslateTransform/>
        </TransformGroup>
    </UserControl.RenderTransform>
    <Grid Margin="40,20,0,0">

        <TextBlock Text="{x:Static Language:Lang.TasksBTN}" Style="{DynamicResource SWPBoldTextBlock}" VerticalAlignment="Top" HorizontalAlignment="Left"/>

        <ScrollViewer Margin="0,70,0,10">
            <StackPanel Orientation="Vertical">
                <PageElement:ETBeginOfTab ETBlabelContent="{x:Static Language:Lang.Tasks_NotificationSystem}"/>
                <PageElement:ETCheckBox Content="{x:Static Language:Lang.Tasks_WarnToAddTaskProperty}" IsChecked="{Binding SWTWarmToAddTask ,Mode=TwoWay}"  HorizontalAlignment="Left" />
                <PageElement:ETCheckBox Content="{x:Static Language:Lang.Tasks_WarnToClosedRunningTask}" IsChecked="{Binding SWTWarmToClosingRunTask ,Mode=TwoWay}"  HorizontalAlignment="Left" />
                <PageElement:ETIntBox ContentOfMainLabel="{x:Static Language:Lang.Tasks_WarningToMinute}" IntBoxValue="{Binding SWTMinuteWarningBeforeRunTask ,Mode=TwoWay}"  HorizontalAlignment="Left"></PageElement:ETIntBox>
                <PageElement:ETEndingOfTab Width="250" HorizontalAlignment="Left"></PageElement:ETEndingOfTab>
                <StackPanel x:Name="TaskRemovalSystem">
                <PageElement:ETBeginOfTab ETBlabelContent="{x:Static Language:Lang.tasks_Task_removal_system}"/>
                <PageElement:ETCheckBox Content="{x:Static Language:Lang.tasks_WhenLockModeIsEnableWeCantDeleteTask}" IsChecked="{Binding SWTWhenLockModeIsEnableWeCantDeleteTask ,Mode=TwoWay}"  HorizontalAlignment="Left" />
                <PageElement:ETCheckBox Content="{x:Static Language:Lang.tasks_WhenLockModeIsEnableWeCantDeleteRecentTask}" IsChecked="{Binding SWTWhenLockModeIsEnableWeCantDeleteRecentTask ,Mode=TwoWay}"  HorizontalAlignment="Left" />
                    <PageElement:ETEndingOfTab Width="250" HorizontalAlignment="Left"></PageElement:ETEndingOfTab>
                </StackPanel>
            </StackPanel>

        </ScrollViewer>
    </Grid>
</UserControl>
