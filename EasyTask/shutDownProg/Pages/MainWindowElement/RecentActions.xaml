<UserControl 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Language="clr-namespace:EasyTask.Properties.Languages"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EasyTask.Pages.MainWindowElement" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="EasyTask.Pages.MainWindowElement.RecentActions" 
                x:Name="RecentActionsX" Margin="10,0,10,0" 
      MinWidth="300" MinHeight="400"
       HorizontalAlignment="Stretch" VerticalAlignment="Top" Loaded="RecentActions_Loaded"
       
      
      >
    <UserControl.Resources>
        <ResourceDictionary>
            <Storyboard x:Key="In">

                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RecentActions" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="1">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RecentActionsX" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00" Value="100">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <PowerEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <PowerEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.RenderTransform>

        <TransformGroup>
            <ScaleTransform/>
            <SkewTransform/>
            <RotateTransform/>
            <TranslateTransform/>
        </TransformGroup>
    </UserControl.RenderTransform>
    <Grid >
        <Grid Height="200" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,0,015,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="200"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions >
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource RAPESec}" CornerRadius="5">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static Language:Lang.RecentActions_LastAction}" HorizontalAlignment="Center"  VerticalAlignment="Top" Margin="0,0,0,0"  Foreground="{DynamicResource RAPELightRingColor}"/>
                    <TextBlock x:Name="LastTaskName" Text="{x:Static Language:Lang.DefaultTextName_Empty}" Foreground="{DynamicResource labelContent}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="15,10,15,0" FontSize="24" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold"  />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0">
                        <TextBlock Text="{x:Static Language:Lang.RecentActions_Action}" TextWrapping="Wrap" Foreground="{DynamicResource labelContent}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Light"  />
                        <TextBlock x:Name="LastTaskActions" Text="{x:Static Language:Lang.DefaultTextName_Empty}" Foreground="{DynamicResource labelContent}"   Margin="10,0,0,0" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Light"  />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Visibility="Visible"  CornerRadius="0,10,10,0">
                <Grid>
                    


                </Grid>

            </Border>
        </Grid>
        <Grid Margin="0,220,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <ScrollViewer Margin="0,0,0,20">
                <StackPanel x:Name="ContentsOfRecentActions"   />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
