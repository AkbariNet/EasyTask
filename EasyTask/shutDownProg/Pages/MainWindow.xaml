<ui:FluentWindow x:Name="MainWindowEasyTask" x:Class="EasyTask.MainWindow"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"  
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="{DynamicResource FlowAll}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" Closing="window_Closing"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EasyTask.Pages" 
        xmlns:ChildrensMe="clr-namespace:EasyTask.Pages.MainWindowElement" 
        xmlns:Language="clr-namespace:EasyTask.Properties.Languages"
        mc:Ignorable="d"
                
        
        Title="Easy Task" MinWidth="700" MinHeight="540" 
         Background="{DynamicResource Contentborder}"
        WindowStartupLocation="CenterScreen" 
        Loaded="Window_Loaded" 
         Icon="/Resources/Original.png"
        Width="800" Height="600"  >

    <ui:FluentWindow.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary x:Name="clockIcon" Source="..\files\icons\ClockIcon\ClockIcon.xaml"/>
                <ResourceDictionary x:Name="RecentIcon" Source="..\files\icons\RecentIcon\RecentIconPro.xaml"/>
                <ResourceDictionary x:Name="aboutIcon" Source="..\files\icons\AboutIcon\AboutIcon.xaml"/>
                <ResourceDictionary x:Name="ExitIcon" Source="..\files\icons\ExitIcon\ExitIcon.xaml"/>
                <ResourceDictionary x:Name="LihgtIcon" Source="..\files\icons\LightIcon\LightIcon.xaml"/>
                <ResourceDictionary x:Name="DarkIcon" Source="..\files\icons\DarkIcon\DarkIcon.xaml"/>
                <ResourceDictionary x:Name="SettingsIcon" Source="..\files\icons\SettingsIcon\SettingsIcon.xaml"/>
                <ResourceDictionary x:Name="UpScrollIcon" Source="..\files\icons\UpDownScroll\UpScroll\UpScroll.xaml"/>
                <ResourceDictionary x:Name="DownScrollIcon" Source="..\files\icons\UpDownScroll\DownScroll\DownScroll.xaml"/>
                <ResourceDictionary x:Name="LockIcon" Source="..\files\icons\LockIcon\LockIcon\LockIcon.xaml"/>
                <ResourceDictionary x:Name="UnLockIcon" Source="..\files\icons\LockIcon\UnLockIcon\UnLockIcon.xaml"/>
                <ResourceDictionary x:Name="LinkIcon" Source="..\files\icons\LinkIcon\LinkIcon.xaml"/>
                <ResourceDictionary x:Name="LanguageIcon" Source="..\files\icons\LanguageIcon\LanguageIcon.xaml"/>
                <ResourceDictionary x:Name="RingIcon" Source="..\files\icons\RingIcon\RingIcon\RingIcon.xaml"/>
                <ResourceDictionary x:Name="RingDIcon" Source="..\files\icons\RingIcon\RingDIcon\RingDIcon.xaml"/>
                <ResourceDictionary x:Name="NothingImage" Source="..\files\icons\NothingIcon\NothingIcon.xaml"/>




            </ResourceDictionary.MergedDictionaries>


            <Storyboard x:Key="OutFocusElementIn">

                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OutFocusDarkBorder" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="1">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OutFocusDarkBorder" Storyboard.TargetProperty="(UIElement.Visibility)">
                    <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Visible}"/>
                </ObjectAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="OutFocusElementOut" >

                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OutFocusDarkBorder" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00" Value="1">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OutFocusDarkBorder" Storyboard.TargetProperty="(UIElement.Visibility)">
                    <DiscreteObjectKeyFrame KeyTime="00:00:00.3000000" Value="{x:Static Visibility.Collapsed}"/>
                </ObjectAnimationUsingKeyFrames>
            </Storyboard>
            
            <Storyboard x:Key="clockClick">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RecentIconBar" Storyboard.TargetProperty="(FrameworkElement.Width)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="20"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RecentIconBar" Storyboard.TargetProperty="(FrameworkElement.Height)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="20"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AboutIconBar" Storyboard.TargetProperty="(FrameworkElement.Width)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="20"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AboutIconBar" Storyboard.TargetProperty="(FrameworkElement.Height)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="20"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ClockIconBar" Storyboard.TargetProperty="(FrameworkElement.Width)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="30"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ClockIconBar" Storyboard.TargetProperty="(FrameworkElement.Height)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="30"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="rectangle" Storyboard.TargetProperty="(FrameworkElement.Width)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="60"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="rectangle" Storyboard.TargetProperty="(FrameworkElement.Height)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="60"/>
                </DoubleAnimationUsingKeyFrames>
                <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="rectangle" Storyboard.TargetProperty="(FrameworkElement.Margin)">
                    <EasingThicknessKeyFrame KeyTime="00:00:00.2000000" Value="0,0,0,0"/>
                </ThicknessAnimationUsingKeyFrames>
                <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="AboutIconBar" Storyboard.TargetProperty="(FrameworkElement.Margin)">
                    <EasingThicknessKeyFrame KeyTime="00:00:00.2000000" Value="0,10,0,0"/>
                </ThicknessAnimationUsingKeyFrames>
                <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="ClockIconBar" Storyboard.TargetProperty="(FrameworkElement.Margin)">
                    <EasingThicknessKeyFrame KeyTime="00:00:00.2000000" Value="0,15,0,25"/>
                </ThicknessAnimationUsingKeyFrames>
                <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="RecentIconBar" Storyboard.TargetProperty="(FrameworkElement.Margin)">
                    <EasingThicknessKeyFrame KeyTime="00:00:00.2000000" Value="0,0,0,0"/>
                </ThicknessAnimationUsingKeyFrames>

            </Storyboard>
            <Storyboard x:Key="recentClick">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ClockIconBar" Storyboard.TargetProperty="(FrameworkElement.Width)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="20"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ClockIconBar" Storyboard.TargetProperty="(FrameworkElement.Height)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="20"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AboutIconBar" Storyboard.TargetProperty="(FrameworkElement.Width)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="20"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AboutIconBar" Storyboard.TargetProperty="(FrameworkElement.Height)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="20"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RecentIconBar" Storyboard.TargetProperty="(FrameworkElement.Width)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="30"/>
                </DoubleAnimationUsingKeyFrames>
                <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="rectangle" Storyboard.TargetProperty="(FrameworkElement.Margin)">
                    <EasingThicknessKeyFrame KeyTime="00:00:00.2000000" Value="0,55,0,0"/>
                </ThicknessAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RecentIconBar" Storyboard.TargetProperty="(FrameworkElement.Height)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="48"/>
                </DoubleAnimationUsingKeyFrames>
                <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="AboutIconBar" Storyboard.TargetProperty="(FrameworkElement.Margin)">
                    <EasingThicknessKeyFrame KeyTime="00:00:00.2000000" Value="0,0,0,0"/>
                </ThicknessAnimationUsingKeyFrames>
                <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="ClockIconBar" Storyboard.TargetProperty="(FrameworkElement.Margin)">
                    <EasingThicknessKeyFrame KeyTime="00:00:00.2000000" Value="0,15,0,25"/>
                </ThicknessAnimationUsingKeyFrames>
                <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="RecentIconBar" Storyboard.TargetProperty="(FrameworkElement.Margin)">
                    <EasingThicknessKeyFrame KeyTime="00:00:00.2000000" Value="0,0,0,25"/>
                </ThicknessAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="AboutClick">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ClockIconBar" Storyboard.TargetProperty="(FrameworkElement.Width)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="20"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ClockIconBar" Storyboard.TargetProperty="(FrameworkElement.Height)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="20"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RecentIconBar" Storyboard.TargetProperty="(FrameworkElement.Width)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="20"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RecentIconBar" Storyboard.TargetProperty="(FrameworkElement.Height)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="20"/>
                </DoubleAnimationUsingKeyFrames>
                <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="rectangle" Storyboard.TargetProperty="(FrameworkElement.Margin)">
                    <EasingThicknessKeyFrame KeyTime="00:00:00.2000000" Value="0,65,0,0"/>
                </ThicknessAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AboutIconBar" Storyboard.TargetProperty="(FrameworkElement.Height)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="48"/>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AboutIconBar" Storyboard.TargetProperty="(FrameworkElement.Width)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="30"/>
                </DoubleAnimationUsingKeyFrames>
                <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="AboutIconBar" Storyboard.TargetProperty="(FrameworkElement.Margin)">
                    <EasingThicknessKeyFrame KeyTime="00:00:00.2000000" Value="0,20,0,20"/>
                </ThicknessAnimationUsingKeyFrames>
                <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="ClockIconBar" Storyboard.TargetProperty="(FrameworkElement.Margin)">
                    <EasingThicknessKeyFrame KeyTime="00:00:00.2000000" Value="0,0,0,0"/>
                </ThicknessAnimationUsingKeyFrames>
                <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="RecentIconBar" Storyboard.TargetProperty="(FrameworkElement.Margin)">
                    <EasingThicknessKeyFrame KeyTime="00:00:00.2000000" Value="0,10,0,0"/>
                </ThicknessAnimationUsingKeyFrames>
            </Storyboard>
            <ImageBrush x:Key="UpScrollImg" ImageSource="{DynamicResource upscrollDrawingImage}"></ImageBrush>
            <ImageBrush x:Key="DownScrollImg" ImageSource="{DynamicResource downscrollDrawingImage}"></ImageBrush>
            <SolidColorBrush x:Key="Main" Color="#666666"></SolidColorBrush>
            <SolidColorBrush x:Key="sec" Color="#ffffff"></SolidColorBrush>
        </ResourceDictionary>


    </ui:FluentWindow.Resources>

    <Grid x:Name="EasyTask" Width="auto" Height="auto" >

        <Grid.RowDefinitions>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="WidthOfRecOfSlideBar" Width="100px"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ui:ClientAreaBorder  x:Name="Contents" Background="{DynamicResource Contentborder}"  BorderThickness="0" CornerRadius="0,0,0,0" Width="NaN" Grid.RowSpan="2"  Grid.Column="1">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
               
                <Grid Margin="0,30,0,0">
                <Grid x:Name="Content_Grid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"  Margin="10,20,10,0"  >

                </Grid>
                </Grid>
            </Grid>
        </ui:ClientAreaBorder>
        <Border x:Name="SlideBar" BorderBrush="Transparent" BorderThickness="0" Grid.Column="0" Grid.RowSpan="2"  Background="{DynamicResource selectborder}">
            <Border x:Name="SlideBarForSelect" Margin="0,30,0,0" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0,0,0,0">

                <Grid x:Name="GridOfSlideBarForSelect">
                    <Rectangle x:Name="rectangle" Height="60" Width="60" Margin="0,0,0,0" Fill="{DynamicResource RecOfselectborder}" StrokeThickness="0" RadiusX="10" RadiusY="10" VerticalAlignment="Top" HorizontalAlignment="Center">
                       
                    </Rectangle>
                    <Grid Width="80" Height="25" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,60">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="LockButton" Visibility="Collapsed" Click="LockButton_Click">
                            <Button.Template >
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border  >
                                        <Image Source="{DynamicResource LockIconDrawingImage}" Margin="5,5,5,5"/>
                                    </Border>

                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="0" x:Name="UnLockButton" Visibility="Collapsed" Click="UnLockButton_Click">
                            <Button.Template >
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border  >
                                        <Image Source="{DynamicResource UnlockIconDrawingImage}" Margin="5,5,5,5"/>
                                    </Border>

                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="2" x:Name="LanguageButton" Click="LanguageButton_Click" >
                            <Button.Template >
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border  >
                                        <Image Source="{DynamicResource LanguageIconDrawingImage}" Margin="5,5,5,5"/>
                                    </Border>

                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="4" Visibility="Collapsed" x:Name="RingButton" Click="RingButton_Click">
                            <Button.Template >
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Grid >
                                        <Image Source="{DynamicResource RingIconDrawingImage}" x:Name="RingDIcon" Margin="5,5,5,5"/>
                                    </Grid>

                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="4" x:Name="RingDButton" Visibility="Collapsed" Click="RingDButton_Click">
                            <Button.Template >
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Grid >
                                        <Image Source="{DynamicResource RingDIconDrawingImage}" x:Name="RingDIcon" Margin="5,5,5,5"/>
                                    </Grid>

                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    <Button x:Name="SettingsIconBar" HorizontalAlignment="Center" Height="30" VerticalAlignment="Bottom" Width="80"  RenderTransformOrigin="0.5,0.5" Click="SettingsIconBar_Click" Margin="0,0,0,20">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">

                                <Border Background="{DynamicResource buttonborder}">
                                    <Grid>
                                        <Image
                                            Source="{StaticResource settingsDrawingImage}" x:Name="picSettings" VerticalAlignment="Center" Height="42" HorizontalAlignment="Center">
                                            <Image.RenderTransform
                                        >
                                                <TransformGroup
                                        >
                                                    <ScaleTransform
                                        />
                                                    <SkewTransform
                                        />
                                                    <RotateTransform
                                        />
                                                    <TranslateTransform
                                        />
                                                </TransformGroup>
                                            </Image.RenderTransform>
                                        </Image>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                        <Button x:Name="ClockIconBar" HorizontalAlignment="Center" Height="30" Width="30" Click="ClockIconBar_Click" Margin="0,15,0,25"  >
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <ContentControl>
                                        <Grid>
                                            <Image Source="{DynamicResource ClockIconDrawingImage}" x:Name="picMain"/>
                                        </Grid>
                                    </ContentControl>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="ButtonBase.Click">
                                    <BeginStoryboard Storyboard="{StaticResource clockClick}"/>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>

                        <Button x:Name="RecentIconBar" HorizontalAlignment="Center" Height="20"  Width="20"  RenderTransformOrigin="0.5,0.5"  Click="RecentIconBar_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <ContentControl>
                                        <Grid>
                                            <Image Source="{DynamicResource RecentIconNewDrawingImage}"  x:Name="picRecent" >
                                                <Image.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform/>
                                                        <SkewTransform/>
                                                        <RotateTransform/>
                                                        <TranslateTransform/>
                                                    </TransformGroup>
                                                </Image.RenderTransform>
                                            </Image>
                                        </Grid>
                                    </ContentControl>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="ButtonBase.Click">
                                    <BeginStoryboard Storyboard="{StaticResource recentClick}"/>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button x:Name="AboutIconBar" Visibility="Collapsed" Margin="0,10,0,0" HorizontalAlignment="Center" Height="20" VerticalAlignment="Top" Width="20"  RenderTransformOrigin="0.5,0.5"  Click="AboutIconBar_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <ContentControl>
                                        <Grid>
                                            <Image Source="{DynamicResource AboutIconDrawingImage}"  x:Name="picRecent" >
                                                <Image.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform/>
                                                        <SkewTransform/>
                                                        <RotateTransform/>
                                                        <TranslateTransform/>
                                                    </TransformGroup>
                                                </Image.RenderTransform>
                                            </Image>
                                        </Grid>
                                    </ContentControl>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="ButtonBase.Click">
                                    <BeginStoryboard Storyboard="{StaticResource AboutClick}"/>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>
                    </StackPanel>
                    <Label Content="{Binding AlarmTime}" HorizontalAlignment="Center" Margin="0,248,0,0" VerticalAlignment="Top"/>
                </Grid>
            </Border>
        </Border>
        <ui:TitleBar 
            x:Name="MainWindowTitleBar" 
            Title="{Binding ViewModel.ApplicationTitle}" ButtonsForeground="{DynamicResource RibbonBarButtonsForegroundColor}"
            Grid.Row="0"  Background="Transparent"  Height="30" 
            CloseWindowByDoubleClickOnIcon="True" Grid.ColumnSpan="2" Margin="0,0,0,0">
            <ui:TitleBar.Icon>
                <ui:ImageIcon  />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <Grid  Grid.ColumnSpan="2" Grid.RowSpan="2" >
            <Border Background="#66000000" Visibility="Collapsed" x:Name="OutFocusDarkBorder"></Border>
            <Grid x:Name="PlaceForFillAll">
                
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
