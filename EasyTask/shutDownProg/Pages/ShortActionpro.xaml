<UserControl x:Class="EasyTask.Pages.ShortActionpro"
              FlowDirection="{DynamicResource FlowAll}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:shutDownProg.Pages" 
             xmlns:Language="clr-namespace:EasyTask.Properties.Languages"
             mc:Ignorable="d" x:Name="ShortActionProName"
              d:Width="auto" MinWidth="420" Margin="0,0,0,10"   >
    <UserControl.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary x:Name="MoreIcon" Source="..\files\icons\MoreIcon\MoreIcon.xaml"/>
                <ResourceDictionary x:Name="MoreIconTrue" Source="..\files\icons\MoreIcon\MoreIconTrue.xaml"/>
                <ResourceDictionary x:Name="RestartIcon" Source="..\files\icons\RestartIcon\RestartIcon.xaml"/>
                <ResourceDictionary x:Name="SleepIcon" Source="..\files\icons\SleepIcon\SleepIcon.xaml"/>
                <ResourceDictionary x:Name="SleepIconTrue" Source="..\files\icons\SleepIcon\SleepIconTrue.xaml"/>
                <ResourceDictionary x:Name="ShutDownIcon" Source="..\files\icons\ShutDownIcon\ShutDownIcon.xaml"/>
                <ResourceDictionary x:Name="ShutDownTrueIcon" Source="..\files\icons\ShutDownIcon\ShutDownIconTrue.xaml"/>
                <ResourceDictionary x:Name="RestartIconTrue" Source="..\files\icons\RestartIcon\RestartIconTrue.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Storyboard x:Key="MoreContentIn">
                <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="MoreContentGrid" Storyboard.TargetProperty="(FrameworkElement.Margin)">
                    <EasingThicknessKeyFrame KeyTime="00:00:00.2000000" Value="0,110,0,0"/>
                </ThicknessAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MoreContentGrid" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00.1000000" Value="0"/>
                    <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="1"/>
                </DoubleAnimationUsingKeyFrames>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MoreContentGrid" Storyboard.TargetProperty="(UIElement.Visibility)">
                    <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Visible}"/>
                </ObjectAnimationUsingKeyFrames>

            </Storyboard>
            <Storyboard x:Key="MoreContentOut">
                <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="MoreContentGrid" Storyboard.TargetProperty="(FrameworkElement.Margin)">
                    <EasingThicknessKeyFrame KeyTime="00:00:00.2000000" Value="0,-97,0,0"/>
                    <!--
                    <EasingThicknessKeyFrame KeyTime="00:00:00.3000000" Value="0,0,0,0"/>
                    -->
                </ThicknessAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MoreContentGrid" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00.1000000" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MoreContentGrid" Storyboard.TargetProperty="(UIElement.Visibility)">
                    <DiscreteObjectKeyFrame KeyTime="00:00:00.2000000" Value="{x:Static Visibility.Collapsed}"/>

                </ObjectAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="RemovingThis" Completed="RemovingThis_Accepted">
                <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="ShortActionProName" Storyboard.TargetProperty="(FrameworkElement.Margin)">
                    <EasingThicknessKeyFrame KeyTime="00:00:00.2000000" Value="0,-293,0,0"/>

                </ThicknessAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShortActionProName" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00.0300000" Value="0"/>
                </DoubleAnimationUsingKeyFrames>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ShortActionProName" Storyboard.TargetProperty="(UIElement.Visibility)">
                    <DiscreteObjectKeyFrame KeyTime="00:00:00.3000000" Value="{x:Static Visibility.Collapsed}"/>

                </ObjectAnimationUsingKeyFrames>

            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Height="auto" Width="auto">

        <Grid x:Name="MoreContentGrid" Visibility="Collapsed" Height="183" Opacity="0" VerticalAlignment="Top" Margin="0,-97,0,0"  >
            <Button FontWeight="SemiBold" x:Name="deleteButtonTask" Content="{x:Static Language:Lang.ShortActionPro_deleteButtonTask}"  Background="{x:Null}" Foreground="{DynamicResource BTNBackgroundSAP}"  BorderThickness="0,0,0,0" Click="deleteButtonTask_Click_1"  HorizontalAlignment="Right" Width="75" Height="30" VerticalAlignment="Bottom" >
                <Button.Resources>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="CornerRadius" Value="15"/>
                    </Style>
                </Button.Resources>
            </Button>
            <StackPanel Orientation="Horizontal">
                <Rectangle Visibility="Collapsed" Height="183" VerticalAlignment="Bottom" RadiusX="5" RadiusY="5" Fill="{DynamicResource SecColorSAP}" Stroke="{DynamicResource RecBColorSAP}" StrokeThickness="0"/>
                <StackPanel HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" >
                    <TextBlock FontWeight="SemiBold" Text="{x:Static Language:Lang.ShortActionPro_DateCreated}" HorizontalAlignment="Left" Margin="0,5,0,5" Foreground="{DynamicResource secContentSAP}"   />
                    <TextBlock FontWeight="SemiBold" Text="{x:Static Language:Lang.ShortActionPro_Action}" HorizontalAlignment="Left" Margin="0,5,0,5"  Foreground="{DynamicResource secContentSAP}"  />
                    <TextBlock FontWeight="SemiBold" Text="{x:Static Language:Lang.ShortActionPro_StartDate}" HorizontalAlignment="Left" Margin="0,5,0,5" Foreground="{DynamicResource secContentSAP}"  />
                </StackPanel>
                <StackPanel HorizontalAlignment="Left" Margin="30,10,0,0" Orientation="Vertical" VerticalAlignment="Top">
                    <TextBlock x:Name="dateCreatedPreview" Text="19 sep - 2023" Margin="0,5,0,5" Foreground="{DynamicResource secContentSAP}"  />
                    <TextBlock  x:Name="startDatePreview" Text="19 sep - 2023" Margin="0,5,0,5" Foreground="{DynamicResource secContentSAP}"  />
                    <TextBlock x:Name="actionPreview" Text="Shut Down" Margin="0,5,0,5" Foreground="{DynamicResource secContentSAP}"  />
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid VerticalAlignment="Top">
            <Rectangle Fill="{DynamicResource RecMainColorSAP}" RadiusX="5" RadiusY="5" Height="100"/>
            <TextBlock TextAlignment="Right" x:Name="taskNamePreview" Text="{x:Static Language:Lang.ShortActionPro_ElementName}" Margin="10,10,0,0" VerticalAlignment="Top" Foreground="{DynamicResource labelContentSAP}" FontSize="42" FontWeight="SemiBold" HorizontalAlignment="Left" Height="60" RenderTransformOrigin="0.5,0.5" />
            <TextBlock TextAlignment="Justify" x:Name="startTimePreview" Text="18:00" Foreground="{DynamicResource labelContentSAP}"  FontSize="42" Margin="0,10,10,30" FontWeight="SemiBold" HorizontalAlignment="Right" Height="60"/>

        </Grid>

        <Button  x:Name="MoreIconPic" Width="30" Height="30" Margin="0,60,10,0" VerticalAlignment="Top" HorizontalAlignment="Right" Click="MoreIconPic_Click">
            <Button.Template>
                <ControlTemplate>
                    <Image Source="{DynamicResource MoreIconDrawingImage}"></Image>
                </ControlTemplate>
            </Button.Template>
            <Button.Triggers>
                <EventTrigger RoutedEvent="Button.Click">
                    <BeginStoryboard Storyboard="{DynamicResource  MoreContentIn}"/>
                </EventTrigger>
            </Button.Triggers>
        </Button>

        <Button  x:Name="MoreIconTruePic"  Visibility="Collapsed" Width="30" Height="30" Margin="0,60,10,0" VerticalAlignment="Top" HorizontalAlignment="Right"  Click="MoreIconTruePic_Click">
            <Button.Template>
                <ControlTemplate>

                    <Image  Source="{DynamicResource MoreIconTrueDrawing}">
                    </Image>
                </ControlTemplate>
            </Button.Template>
            <Button.Triggers>
                <EventTrigger RoutedEvent="Button.Click">
                    <BeginStoryboard Storyboard="{DynamicResource  MoreContentOut}"/>
                </EventTrigger>
            </Button.Triggers>
        </Button>
        <Image  Source="{DynamicResource RestartIconDrawingImage}" x:Name="RestartIconPic" Width="30" Height="30" Margin="72,60,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Image  Source="{DynamicResource RestartIconTruesDrawingImage}" x:Name="RestartIconTruePic" Visibility="Collapsed" Width="30" Height="30" Margin="72,60,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Image  Source="{DynamicResource ShutDownIconDrawingImage}" x:Name="ShutDownIconPic" Width="30" Height="30" Margin="27,60,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Image  Source="{DynamicResource ShutDownIconTrueDrawingImage}" x:Name="ShutDownIconTruePic" Visibility="Collapsed" Width="30" Height="30" Margin="27,60,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Image  Source="{DynamicResource SleepIconDrawingImage}" x:Name="SleepIconPic" Width="30" Height="30" Margin="117,60,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Image  Source="{DynamicResource SleepIconTrueDrawingGroup}"  x:Name="SleepIconTruePic" Visibility="Collapsed" Width="30" Height="30" Margin="117,60,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
    </Grid>
</UserControl>
