<ui:FluentWindow x:Class="EasyTask.Pages.TwoWayYesNo"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:Language="clr-namespace:EasyTask.Properties.Languages"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EasyTask.Pages" MinWidth="400" MinHeight="300" MaxWidth="400" MaxHeight="300"
        WindowStyle="None"   Topmost="True" FlowDirection="{DynamicResource FlowAll}"
        Title="Process In Product"  WindowStartupLocation="CenterScreen" ResizeMode="NoResize" >
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary x:Name="ExitIcon" Source="..\files\icons\ExitIcon\ExitIcon.xaml"/>
            </ResourceDictionary.MergedDictionaries>


        </ResourceDictionary>
    </Window.Resources>
    <Border   MouseDown="Border_MouseDown" Background="{DynamicResource PIPWSec}">
        <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Width="auto" Height="auto"  >

            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
          
            <Grid x:Name="Contents" Grid.Row="1" MinHeight="220" MinWidth="300" >
                <Border BorderBrush="Transparent" BorderThickness="0"  Background="{DynamicResource PIPWSec}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="50"></RowDefinition>
                            <RowDefinition Height="0"></RowDefinition>
                            <RowDefinition Height="50"></RowDefinition>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="ProssesName" Grid.Row="0" TextAlignment="Center" Text="{x:Static Language:Lang.DefaultTextName_Empty}"   FontWeight="Bold" FontSize="41.89px" Foreground="{DynamicResource PIPWTextBTN}" HorizontalAlignment="Center"  Padding="0,0,0,0" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <ScrollViewer  Grid.Row="1"   MaxHeight="60" HorizontalAlignment="Center">
                            <TextBlock Text="{x:Static Language:Lang.DefaultTextName_Empty}"  TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Top" Padding="0" x:Name="ProssesAbout" MaxWidth="270" FontSize="9.89px" FontWeight="Light" Foreground="{DynamicResource PIPWTextBTN}" Margin="15,0,0,0"/>

                        </ScrollViewer>
                        <Grid HorizontalAlignment="Center"  Grid.Row="3" >

                            <Button MinWidth="100" Height="40" Grid.Column="0" HorizontalAlignment="Center" Margin="0,0,110,0" x:Name="BTN1" Click="BTN1_Click"/>
                            <Button MinWidth="60" Height="40" Grid.Column="1"  HorizontalAlignment="Center" Margin="110,0,0,0" x:Name="BTN2" Click="BTN2_Click"/>
                            <Border Visibility="Collapsed" x:Name="StressButtonColor" Background="{DynamicResource TaskbarIconStyleBLue}"></Border>
                            
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Border>
</ui:FluentWindow>
