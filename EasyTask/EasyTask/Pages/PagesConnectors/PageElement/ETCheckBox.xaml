<CheckBox
    
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EasyTask.Pages.PagesConnectors.PageElement.Childrens" x:Class="EasyTask.Pages.PagesConnectors.PageElement.ETCheckBox"
             mc:Ignorable="d" Height="40" x:Name="CheckBoxElm" Margin="15,5,5,5">
    <CheckBox.Template>
        <ControlTemplate>
    <Border Background="{DynamicResource CBSec}" CornerRadius="3" >
                <Grid>
                    <TextBlock  Text="{Binding ElementName=CheckBoxElm,Path=Content}" Foreground="{DynamicResource CBLMain}"
                    VerticalAlignment="Center"  Margin="10,0,35,0" HorizontalAlignment="Left"/>
                   
            <Grid Margin="10,5,10,5"  HorizontalAlignment="Right"  Width="15">
              
                            <Border Background="{DynamicResource CBSec}"></Border>
                            <local:CheckingBox IsChecked="{Binding ElementName=CheckBoxElm,Path=IsChecked,Mode=TwoWay}"></local:CheckingBox>
                   
            </Grid>

        </Grid>
    </Border>
        </ControlTemplate>
    </CheckBox.Template>
</CheckBox>
