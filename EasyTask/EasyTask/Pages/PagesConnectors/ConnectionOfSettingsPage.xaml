<UserControl
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  x:Name="ConnectionOfSettingsPageX"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  FlowDirection="{DynamicResource FlowAll}"
                 xmlns:Language="clr-namespace:EasyTask.Properties.Languages"
      xmlns:local="clr-namespace:EasyTask.Pages" 
              xmlns:PageElement="clr-namespace:EasyTask.Pages.PagesConnectors.PageElement" x:Class="EasyTask.Pages.PagesConnectors.ConnectionOfSettingsPage" 
              HorizontalAlignment="Left" VerticalAlignment="Top" Loaded="ConnectionOfSettingsPageX_Loaded">

    <UserControl.RenderTransform>
        <TransformGroup>
            <ScaleTransform/>
            <SkewTransform/>
            <RotateTransform/>
            <TranslateTransform/>
        </TransformGroup>
    </UserControl.RenderTransform>

    <Grid Margin="40,20,0,0" >

        <TextBlock Text="{x:Static Language:Lang.ConnectionBTN}" Style="{DynamicResource SWPBoldTextBlock}" VerticalAlignment="Top" HorizontalAlignment="Left"/>

        <ScrollViewer Margin="0,70,0,10">
            <StackPanel Orientation="Vertical" Opacity=".2" IsEnabled="False">
                <PageElement:ETBeginOfTab ETBlabelContent="{x:Static Language:Lang.Connection_Connect}"/>
                <PageElement:ETCheckBox x:Name="AlwaysTry" Content="{x:Static Language:Lang.Connection_AlwaysTry}" IsChecked="{Binding SWCAlwaysTry ,Mode=TwoWay}"  HorizontalAlignment="Left" KeyDown="ETCheckBox_KeyDown" />
                <PageElement:ETIntBox ContentOfMainLabel="{x:Static Language:Lang.Connection_EachTryTime}" IntBoxValue="{Binding SWCEachTry ,Mode=TwoWay}" HorizontalAlignment="Left"/>
                <PageElement:ETEndingOfTab Width="250" HorizontalAlignment="Left"></PageElement:ETEndingOfTab>
                 </StackPanel>

        </ScrollViewer>
    </Grid>
</UserControl>
