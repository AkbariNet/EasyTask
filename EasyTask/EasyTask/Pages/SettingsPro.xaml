<ui:FluentWindow x:Class="EasyTask.Pages.SettingsPro" 
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ResizeMode="CanMinimize" Title="Settings"
                 ui:Design.Background="{DynamicResource SWB}"
    ui:Design.Foreground="{DynamicResource SWMain}" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EasyTask" Background="{DynamicResource SWB}" FlowDirection="{DynamicResource FlowAll}"
                 xmlns:Language="clr-namespace:EasyTask.Properties.Languages"
        mc:Ignorable="d" Height="500" Width="900"  MinHeight="300" MinWidth="650" WindowStartupLocation="CenterScreen" Closing="Window_Closing" Loaded="FluentWindow_Loaded" SizeChanged="FluentWindow_SizeChanged" >

    <ui:FluentWindow.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary x:Name="ExitIcon" Source="..\files\icons\ExitIcon\ExitIcon.xaml"/>
                <ResourceDictionary x:Name="MinimizeIcon" Source="..\files\icons\Minimize\MinimizeIcon.xaml"/>
                <ResourceDictionary x:Name="SettingsProIcons" Source="pack://application:,,,/files/SettingsProIcons/SettingsProIcons.xaml"/>
                <ResourceDictionary x:Name="ScrollDic" Source="ScrollDictionary.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Storyboard x:Key="In">

                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SettingsBar" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="1">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SettingsBar" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00" Value="100">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <PowerEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <PowerEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            
            <!--For Sandwich-->

            <Storyboard x:Key="SandwichIn" x:Name="SandwichIn" >

                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SandwichPanel" Storyboard.TargetProperty="(UIElement.Opacity)">
               
                    <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="100">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="SandwichPanel" Storyboard.TargetProperty="(FrameworkElement.Margin)">

                    <EasingThicknessKeyFrame KeyTime="00:00:00.3000000" Value="0,0,0,0"/>
                </ThicknessAnimationUsingKeyFrames>
                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SandwichPanel"   Storyboard.TargetProperty="(UIElement.Visibility)">
                    <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Visible}"/>
                </ObjectAnimationUsingKeyFrames>
            </Storyboard>

            <Storyboard x:Key="MiniSandwichOut" x:Name="MiniSandwichOut" >

                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MiniSandwichPanel"   Storyboard.TargetProperty="(UIElement.Visibility)">
                    <DiscreteObjectKeyFrame KeyTime="00:00:00.3" Value="{x:Static Visibility.Collapsed}"/>
                </ObjectAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="SandwichOut" x:Name="SandwichOut" >


                <!--ForSandwichHide-->
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SandwichPanel" Storyboard.TargetProperty="(UIElement.Opacity)">
                 
                    <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="SandwichPanel" Storyboard.TargetProperty="(FrameworkElement.Margin)">

                    <EasingThicknessKeyFrame KeyTime="00:00:00.3000000" Value="-242,0,0,0"/>
                </ThicknessAnimationUsingKeyFrames>

                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SandwichPanel"   Storyboard.TargetProperty="(UIElement.Visibility)">
                    <DiscreteObjectKeyFrame KeyTime="00:00:00.3000000" Value="{x:Static Visibility.Collapsed}"/>
                </ObjectAnimationUsingKeyFrames>

            </Storyboard>
            <Storyboard x:Key="MiniSandwichIn" x:Name="MiniSandwichIn" >

                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MiniSandwichPanel"   Storyboard.TargetProperty="(UIElement.Visibility)">
                    <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Visible}"/>
                </ObjectAnimationUsingKeyFrames>
            </Storyboard>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <ui:ClientAreaBorder Background="{DynamicResource SWB}">
        <Grid x:Name="AllContents" RenderTransformOrigin="0.5,0.5">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition ></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Grid x:Name="settings_Grid" Grid.RowSpan="2" RenderTransformOrigin="0.5,0.5" >
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"  x:Name="SizeOfSandwichColumn"/>
                    <ColumnDefinition Width="1000*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="MiniSandwichPanel" Visibility="Collapsed" Background="{DynamicResource SWSec}" Width="40" HorizontalAlignment="Left">
                    <StackPanel Width="15" Margin="0,30,0,0">
                        <Button x:Name="MiniSettings" Click="MiniSettings_Click">
                            <Button.Template>
                                <ControlTemplate>

                                    <Image Source="{DynamicResource SettingsProIconDrawingImage}" Margin="0,0,0,5"></Image>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="ProcessMBTN" Click="ProcessBTN_Click">
                            <Button.Template>
                                <ControlTemplate>

                                    <Image Source="{DynamicResource ProcessIconDrawingImage}" Margin="0,5,0,5"></Image>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="ConnectionMBTN" Click="ConnectionBTN_Click">
                            <Button.Template>
                                <ControlTemplate>
                                    <Image Source="{DynamicResource ConnectionIconDrawingImage}" Margin="0,5,0,5"></Image>

                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="SecurityMBTN" Click="SecurityBTN_Click">
                            <Button.Template>
                                <ControlTemplate>
                                    <Image Source="{DynamicResource SecurityIconDrawingImage}" Margin="0,5,0,5"></Image>

                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="TasksMBTN" Click="TasksBTN_Click">
                            <Button.Template>
                                <ControlTemplate>
                                    <Image Source="{DynamicResource TasksIconDrawingImage}" Margin="0,5,0,5"></Image>

                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="ThemeMBTN" Click="ThemeBTN_Click">
                            <Button.Template>
                                <ControlTemplate>
                                    <Image Source="{DynamicResource ThemeIconDrawingImage}" Margin="0,5,0,5"></Image>

                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <ui:ClientAreaBorder x:Name="SandwichPanel" Visibility="Visible" MinWidth="230"  BorderThickness="0" CornerRadius="0,0,0,0" Background="{DynamicResource SWSec}">
                    <Grid x:Name="SettingsBar" Margin="0,30,0,0">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Grid.RenderTransform>
                         <TextBlock Grid.Row="0" Text="{x:Static Language:Lang.SettingsText}"  FontSize="42px" Foreground="{DynamicResource SettingsProTextSec}" Padding="0,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"  FontWeight="SemiBold" Margin="30,10,20,0"/>
                     
                        <ScrollViewer Grid.Row="0" Margin="0,90,0,0" VerticalAlignment="Top"  >
                            <Grid Margin="25,0,0,0">
                                <Grid Height="auto" Width="auto">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50px"/>
                                        <RowDefinition Height="10px"/>
                                        <RowDefinition Height="50px"/>
                                        <RowDefinition Height="10px"/>
                                        <RowDefinition Height="50px"/>
                                        <RowDefinition Height="10px"/>
                                        <RowDefinition Height="50px"/>
                                        <RowDefinition Height="10px"/>
                                        <RowDefinition Height="50px"/>
                                        <RowDefinition Height="10px"/>
                                    </Grid.RowDefinitions>
                                    <Button x:Name="ProcessBTN" Content="{x:Static Language:Lang.ProcessBTN}"  Style="{DynamicResource  SettingsButtonStyle}" Click="ProcessBTN_Click" Grid.Row="0">
                                        <Button.Template>
                                            <ControlTemplate>

                                                <Border Name="border" 
                                                        BorderThickness="{TemplateBinding Property=BorderThickness}"
                                                        Padding="4,2" 
                                                        BorderBrush="Transparent" 
                                                        CornerRadius="5" 
                                                        Background="{TemplateBinding Background}">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Center">
                                                    <Image Source="{DynamicResource ProcessIconDrawingImage}" Width="15" Margin="0,0,10,0"></Image>
                                                        <TextBlock Foreground="{Binding Path=Foreground, ElementName=ProcessBTN}"   HorizontalAlignment="Center"  VerticalAlignment="Center" Text="{Binding Path=Content, ElementName=ProcessBTN}"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Cursor" Value="Hand"></Setter>
                                                        <Setter TargetName="border" Property="BorderBrush" Value="#DCDCDE" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button x:Name="ConnectionBTN"  Content="{x:Static Language:Lang.ConnectionBTN}" Grid.Row="2"  Style="{DynamicResource  SettingsButtonStyle}"  Click="ConnectionBTN_Click" >
                                        <Button.Template>
                                            <ControlTemplate>

                                                <Border Name="border"  BorderThickness="{TemplateBinding Property=BorderThickness}" Padding="4,2"   BorderBrush="Transparent"   CornerRadius="5"  Background="{TemplateBinding Background}">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Center">
                                                        <Image Source="{DynamicResource ConnectionIconDrawingImage}" Width="15" Margin="0,0,10,0"></Image>
                                                        <TextBlock Foreground="{Binding Path=Foreground, ElementName=ConnectionBTN}"   HorizontalAlignment="Center"  VerticalAlignment="Center" Text="{Binding Path=Content, ElementName=ConnectionBTN}"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Cursor" Value="Hand"></Setter>
                                                        <Setter TargetName="border" Property="BorderBrush" Value="#DCDCDE" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button  x:Name="SecurityBTN" Content="{x:Static Language:Lang.SecurityBTN}" Grid.Row="4"  Style="{DynamicResource  SettingsButtonStyle}"  Click="SecurityBTN_Click" >
                                        <Button.Template>
                                            <ControlTemplate>

                                                <Border Name="border" 
                                                    BorderThickness="{TemplateBinding Property=BorderThickness}"
                                                    Padding="4,2" 
                                                    BorderBrush="Transparent" 
                                                    CornerRadius="5" 
                                                    Background="{TemplateBinding Background}">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Center">
                                                        <Image Source="{DynamicResource SecurityIconDrawingImage}" Width="15" Margin="0,0,10,0"></Image>
                                                        <TextBlock Foreground="{Binding Path=Foreground, ElementName=SecurityBTN}"   HorizontalAlignment="Center"  VerticalAlignment="Center" Text="{Binding Path=Content, ElementName=SecurityBTN}"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Cursor" Value="Hand"></Setter>
                                                        <Setter TargetName="border" Property="BorderBrush" Value="#DCDCDE" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button  x:Name="TasksBTN" Content="{x:Static Language:Lang.TasksBTN}" Grid.Row="6"  Style="{DynamicResource  SettingsButtonStyle}"  Click="TasksBTN_Click" >
                                        <Button.Template>
                                            <ControlTemplate>

                                                <Border Name="border"   BorderThickness="{TemplateBinding Property=BorderThickness}"   Padding="4,2"      BorderBrush="Transparent"     CornerRadius="5"   Background="{TemplateBinding Background}">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Center">
                                                        <Image Source="{DynamicResource TasksIconDrawingImage}" Width="15" Margin="0,0,10,0"></Image>
                                                        <TextBlock Foreground="{Binding Path=Foreground, ElementName=TasksBTN}"   HorizontalAlignment="Center"  VerticalAlignment="Center" Text="{Binding Path=Content, ElementName=TasksBTN}"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Cursor" Value="Hand"></Setter>
                                                        <Setter TargetName="border" Property="BorderBrush" Value="#DCDCDE" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button   x:Name="ThemeBTN" Content="{x:Static Language:Lang.ThemeBTN}" Grid.Row="8"  Style="{DynamicResource  SettingsButtonStyle}"  Click="ThemeBTN_Click" >
                                        <Button.Template>
                                            <ControlTemplate>

                                                <Border Name="border" BorderThickness="{TemplateBinding Property=BorderThickness}" Padding="4,2" BorderBrush="Transparent" CornerRadius="5" Background="{TemplateBinding Background}">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Center" >
                                                        <Image Source="{DynamicResource ThemeIconDrawingImage}" Width="15" Margin="0,0,10,0"></Image>
                                                        <TextBlock Foreground="{Binding Path=Foreground, ElementName=ThemeBTN}"   HorizontalAlignment="Center"  VerticalAlignment="Center" Text="{Binding Path=Content, ElementName=ThemeBTN}"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Cursor" Value="Hand"></Setter>
                                                        <Setter TargetName="border" Property="BorderBrush" Value="#DCDCDE" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                   
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                        <Button Grid.RowSpan="20"  x:Name="MinimizeButton" Click="MinimizeButton_Click" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"  Margin="30,0,20,0">
                            <Button.Template>
                                <ControlTemplate>
                                    <Border >
                                        <Image Source="{DynamicResource MinimizeDrawingImage}"  ></Image>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </Grid>
                </ui:ClientAreaBorder>
                <ui:ClientAreaBorder x:Name="Items" Grid.RowSpan="1"  Background="{DynamicResource SWB}"  BorderBrush="Transparent" BorderThickness="0" CornerRadius="0,0,0,0" Grid.Column="1" >

                    <Grid x:Name="TargetGrid"  Margin="0,30,0,0"/>


                </ui:ClientAreaBorder>

            </Grid>
            <Grid x:Name="SpecialGridPlace" Grid.ColumnSpan="3" Grid.RowSpan="3" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5" >
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Grid.RenderTransform>
            </Grid>
            <ui:TitleBar 
            x:Name="TitleBar" ShowMinimize="False" ShowMaximize="False"  Height="30" Foreground="{DynamicResource RibbonBarButtonsForegroundColor}"
            Title="{Binding ViewModel.ApplicationTitle}" ButtonsForeground="{DynamicResource RibbonBarButtonsForegroundColor}" 
            Grid.Row="0"  Background="Transparent"  
              >
                <ui:TitleBar.Icon>
                    <ui:ImageIcon  />
                </ui:TitleBar.Icon>
            </ui:TitleBar>
        </Grid>
    </ui:ClientAreaBorder>
</ui:FluentWindow>
