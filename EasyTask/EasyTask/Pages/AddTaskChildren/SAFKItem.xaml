<UserControl x:Class="EasyTask.Pages.AddTaskChildren.SAFKItem" x:Name="SAFKItems"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="{DynamicResource FlowAll}"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EasyTask.Pages.PagesConnectors.PageElement"
             mc:Ignorable="d"  HorizontalAlignment="Stretch" VerticalAlignment="Top"
             MinWidth="100" MinHeight="50" Margin="15,0,0,0"  IsVisibleChanged="SAFKItems_IsVisibleChanged"
             >
    <Border >
        <Grid >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Border CornerRadius="5" Background="{DynamicResource CBSec}" Width="40" Margin="5">
                <Image x:Name="IconPng" Margin="5" Source="{Binding ElementName=SAFKItems, Path=ImageSourceIconPath}"></Image>
            </Border>
            <local:ETCheckBox x:Name="CheckBox" Grid.Column="1" Click="Button_Click"  IsChecked="{Binding ElementName=SAFKItems, Path=CheckBoxForChackElementValue ,Mode=TwoWay}" Content="{Binding ElementName=SAFKItems, Path=TitleValue}"  Margin="0"  HorizontalAlignment="Stretch"  ></local:ETCheckBox>
                   
        </Grid>
    </Border>
</UserControl>
