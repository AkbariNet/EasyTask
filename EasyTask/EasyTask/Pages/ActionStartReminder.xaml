<Window x:Class="EasyTask.Pages.ActionStartReminder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FlowDirection="{DynamicResource FlowAll}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:shutDownProg.Pages"
        xmlns:Language="clr-namespace:EasyTask.Properties.Languages"
        mc:Ignorable="d" AllowsTransparency="True" MinWidth="700" MinHeight="540"
        Title="Start Action" Height="600" Width="800"  Foreground="{x:Null}" WindowStyle="None" WindowStartupLocation="CenterScreen" WindowState="Maximized"  ResizeMode="NoResize" Icon="/Resources/LightWarning.png" Topmost="True" >
    <Window.Background> 
        <RadialGradientBrush Opacity="0.95"   >
            <GradientStop Color="{DynamicResource ASRWSecColor}" Offset="1" />
            <GradientStop Color="{DynamicResource ASRWMainColor}" Offset="0" />
        </RadialGradientBrush>
    </Window.Background>
    <Grid>
        <Grid x:Name="AllContentOfAction" HorizontalAlignment="Center" VerticalAlignment="Center"  Margin="0,0,0,0">
            <TextBlock x:Name="mainMessage"  Text="null" Foreground="{DynamicResource ASRWMain}" FontWeight="Light" FontSize="48" Height="84" VerticalAlignment="Top"/>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Top"  Margin="0,0,0,0" >
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TimeStartActionText" Text="30" Foreground="{DynamicResource ASRWC}"  FontSize="110" Height="134"/>
                    <TextBlock Text="{x:Static Language:Lang.ActionStartReminder_Secound}" Foreground="{DynamicResource ASRWMain}" FontWeight="SemiBold" FontSize="68" HorizontalAlignment="Center" VerticalAlignment="Center"  Margin="10,30,0,0"/>
                </StackPanel>

                <Button x:Name="cancelAction" Content="{x:Static Language:Lang.DefaultTextName_Cancel}" Height="50" Margin="0,220,0,0" Width="400" Background="{DynamicResource ASRWButtonColor}" FontWeight="Light" FontSize="24" Cursor="Hand" Click="cancelAction_Click" VerticalAlignment="Bottom" HorizontalAlignment="Center">

                </Button>
            </Grid>

        </Grid>

    </Grid>
</Window>
