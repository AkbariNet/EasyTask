<UserControl x:Class="EasyTask.Pages.MainWindowElement.SelectLanguage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"       
             xmlns:Language="clr-namespace:EasyTask.Properties.Languages"
             xmlns:local="clr-namespace:EasyTask.Pages.MainWindowElement"
             xmlns:LangElm="clr-namespace:EasyTask.Pages.MainWindowElement.Elements"
             mc:Ignorable="d"  
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>

        <ResourceDictionary>
            <Storyboard x:Key="In">

                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SelectLanguage" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="1">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="Out" Completed="Out_Completed">

                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SelectLanguage" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00" Value="1">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="{DynamicResource SLRingColor}" x:Name="MainBorder">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="2*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0"  Margin="50,5,50,5" >
                <lottie:LottieAnimationView FlowDirection="LeftToRight" x:Name="AN" 
    AutoPlay="True" IsPlaying="True"              MaxWidth="300" MaxHeight="800"
    ResourcePath="pack://application:,,,/files/SVGANIMATE/ChangeLanguageAnimate/ChangeLanguageAnimate.json"
    RepeatCount="-1" />
            </Grid>
            <Grid Grid.Column="1" Background="{DynamicResource SLSec}">
                <Grid Margin="0,0,0,0" >
                    <TextBlock Text="{x:Static Language:Lang.SelectLanguage_Select_your_language}" Foreground="{DynamicResource SLMain}" FontWeight="Bold" FontSize="25.89px" Margin="0,50,5,0" HorizontalAlignment="Center" VerticalAlignment="Top"></TextBlock>
                    <ScrollViewer  Margin="40,120,30,40" Foreground="{DynamicResource SLB}">
                        <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Top" MaxWidth="500"  >

                            <Button  x:Name="ButtonForCopyExample" Visibility="Collapsed" BorderBrush="{DynamicResource SLB}" Foreground="{DynamicResource SLMain}" Margin="0,0,0,20">
                                <Button.Template>
                                    <ControlTemplate>
                                        <LangElm:SLElement NameOfLanguage="Spanish" BackGR="{TemplateBinding Property=BorderBrush}" ForeGR="{TemplateBinding Property=Foreground}"></LangElm:SLElement>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="EnglighLang" Click="EnglighLang_Click" BorderBrush="{DynamicResource SLB}" Foreground="{DynamicResource SLMain}" Margin="0,0,0,20">
                                <Button.Template>
                                    <ControlTemplate>
                                        <LangElm:SLElement NameOfLanguage="English" BackGR="{TemplateBinding Property=BorderBrush}" ForeGR="{TemplateBinding Property=Foreground}"></LangElm:SLElement>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="PersianLang" Click="PersianLang_Click" BorderBrush="{DynamicResource SLB}" Foreground="{DynamicResource SLMain}" Margin="0,0,0,20">
                                <Button.Template>
                                    <ControlTemplate>
                                        <LangElm:SLElement NameOfLanguage="فارسی" FontFamily="pack://application:,,,/files/Fonts/Vazirmatn.ttf #Vazirmatn" BackGR="{TemplateBinding Property=BorderBrush}" ForeGR="{TemplateBinding Property=Foreground}"></LangElm:SLElement>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button  x:Name="SpanishLang" Click="SpanishLang_Click" BorderBrush="{DynamicResource SLB}" Foreground="{DynamicResource SLMain}" Margin="0,0,0,20">
                                <Button.Template>
                                    <ControlTemplate>
                                        <LangElm:SLElement NameOfLanguage="español" BackGR="{TemplateBinding Property=BorderBrush}"  ForeGR="{TemplateBinding Property=Foreground}"></LangElm:SLElement>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button  x:Name="FrenchLang" Click="FrenchLang_Click" BorderBrush="{DynamicResource SLB}" Foreground="{DynamicResource SLMain}" Margin="0,0,0,20">
                                <Button.Template>
                                    <ControlTemplate>
                                        <LangElm:SLElement NameOfLanguage="Français" BackGR="{TemplateBinding Property=BorderBrush}"  ForeGR="{TemplateBinding Property=Foreground}"></LangElm:SLElement>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button  x:Name="GermanLang" Click="GermanLang_Click" BorderBrush="{DynamicResource SLB}" Foreground="{DynamicResource SLMain}" Margin="0,0,0,20">
                                <Button.Template>
                                    <ControlTemplate>
                                        <LangElm:SLElement NameOfLanguage="Deutsch" BackGR="{TemplateBinding Property=BorderBrush}"  ForeGR="{TemplateBinding Property=Foreground}"></LangElm:SLElement>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button  x:Name="ChineseLang" Click="ChineseLang_Click" BorderBrush="{DynamicResource SLB}" Foreground="{DynamicResource SLMain}" Margin="0,0,0,20">
                                <Button.Template>
                                    <ControlTemplate>
                                        <LangElm:SLElement NameOfLanguage="中国人" BackGR="{TemplateBinding Property=BorderBrush}"  ForeGR="{TemplateBinding Property=Foreground}"></LangElm:SLElement>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button  x:Name="RussianLang" Click="RussianLang_Click" BorderBrush="{DynamicResource SLB}" Foreground="{DynamicResource SLMain}" Margin="0,0,0,20">
                                <Button.Template>
                                    <ControlTemplate>
                                        <LangElm:SLElement NameOfLanguage="Русский" BackGR="{TemplateBinding Property=BorderBrush}"  ForeGR="{TemplateBinding Property=Foreground}"></LangElm:SLElement>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button  x:Name="PortugueseLang" Click="PortugueseLang_Click" BorderBrush="{DynamicResource SLB}" Foreground="{DynamicResource SLMain}" Margin="0,0,0,20">
                                <Button.Template>
                                    <ControlTemplate>
                                        <LangElm:SLElement NameOfLanguage="Português" BackGR="{TemplateBinding Property=BorderBrush}"  ForeGR="{TemplateBinding Property=Foreground}"></LangElm:SLElement>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button  x:Name="ArabicLang" Click="ArabicLang_Click" BorderBrush="{DynamicResource SLB}" Foreground="{DynamicResource SLMain}" Margin="0,0,0,20">
                                <Button.Template>
                                    <ControlTemplate>
                                        <LangElm:SLElement NameOfLanguage="العربیه" FontFamily="pack://application:,,,/files/Fonts/Vazirmatn.ttf #Vazirmatn" BackGR="{TemplateBinding Property=BorderBrush}" ForeGR="{TemplateBinding Property=Foreground}"></LangElm:SLElement>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
            <Grid Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="Collapsed"  x:Name="ProcessingToChange">
                <Border Background="{DynamicResource SLRingColor}" >
                    <TextBlock Text="Language is changed!" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="48" FontWeight="Bold"></TextBlock>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
