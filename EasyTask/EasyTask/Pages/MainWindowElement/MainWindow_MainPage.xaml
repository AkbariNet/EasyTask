<UserControl x:Class="EasyTask.Pages.MainWindowElement.MainWindow_MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EasyTask.Pages.MainWindowElement" 
                     xmlns:Language="clr-namespace:EasyTask.Properties.Languages"
      mc:Ignorable="d"  Width="NaN"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Loaded="UserControl_Loaded"
      >

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary x:Name="NewTaskIcon" Source="..\..\files\icons\newtaskicon\newtaskicon.xaml"/>
                <ResourceDictionary x:Name="NothingIcon" Source="..\..\files\icons\NothingIcon\NothingIcon.xaml"/>

            </ResourceDictionary.MergedDictionaries>

            <Storyboard x:Key="NothingIconIn">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NothingIconPic" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="1">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NothingIconPic" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00" Value="100">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <PowerEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <PowerEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <Storyboard x:Key="ShortActionProIn">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="gridForActions" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="1">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <CircleEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="gridForActions" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)">
                    <EasingDoubleKeyFrame KeyTime="00:00:00" Value="100">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <PowerEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                    <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0">
                        <EasingDoubleKeyFrame.EasingFunction>
                            <PowerEase EasingMode="EaseOut"/>
                        </EasingDoubleKeyFrame.EasingFunction>
                    </EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
        <Grid x:Name="MainContentGrid" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" SharedSizeGroup="MySize"/>
            </Grid.ColumnDefinitions>
           
            <TextBlock x:Name="ShowError" Visibility="Collapsed" Text="Error" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30" Foreground="#FFFF8585"/>
            <Label x:Name="LableOfPage" Visibility="Collapsed" Content="Your Task's" Foreground="{DynamicResource labelContent}" HorizontalAlignment="Left" Width="223" VerticalAlignment="Top" />
               
                
                <ScrollViewer  x:Name="ShortActionsScrollViewer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"   Visibility="Visible"  Margin="10,0,0,80" Grid.Column="0" MinWidth="400" Width="NaN"  >
            
                <DockPanel>
                    <StackPanel x:Name="gridForActions"   >

                        <StackPanel.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </StackPanel.RenderTransform>
                    </StackPanel>
                </DockPanel>

                </ScrollViewer>
            
            <Button x:Name="AddTaskIcon"  Height="30" Width="auto" Click="AddTaskIcon_Click" Margin="0,0,15,25" HorizontalAlignment="Right" VerticalAlignment="Bottom" VerticalContentAlignment="Center">
               
                <Button.Template >
                    <ControlTemplate TargetType="{x:Type Button}" >
                        <ContentControl>
                            <Border >
                                <Border.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform/>
                                        <TranslateTransform />
                                    </TransformGroup>
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderOfButton"  Storyboard.TargetProperty="(UIElement.Visibility)">
                                                    <DiscreteObjectKeyFrame KeyTime="00:00:00.0000000" Value="{x:Static Visibility.Visible}"/>

                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BorderOfButton"   Storyboard.TargetProperty="(UIElement.Opacity)">

                                                    <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="1">
                                                        <EasingDoubleKeyFrame.EasingFunction>
                                                            <CircleEase EasingMode="EaseOut"/>
                                                        </EasingDoubleKeyFrame.EasingFunction>
                                                    </EasingDoubleKeyFrame>
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BorderOfButton"   Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)">

                                                    <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0">
                                                        <EasingDoubleKeyFrame.EasingFunction>
                                                            <PowerEase EasingMode="EaseOut"/>
                                                        </EasingDoubleKeyFrame.EasingFunction>
                                                    </EasingDoubleKeyFrame>
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderOfButton"   Storyboard.TargetProperty="(UIElement.Visibility)">
                                                    <DiscreteObjectKeyFrame KeyTime="00:00:00.3000000" Value="{x:Static Visibility.Collapsed}"/>

                                                </ObjectAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BorderOfButton"   Storyboard.TargetProperty="(UIElement.Opacity)">
                                             
                                                    <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="0">
                                                        <EasingDoubleKeyFrame.EasingFunction>
                                                            <CircleEase EasingMode="EaseOut"/>
                                                        </EasingDoubleKeyFrame.EasingFunction>
                                                    </EasingDoubleKeyFrame>
                                                </DoubleAnimationUsingKeyFrames>
                                                <DoubleAnimationUsingKeyFrames  Storyboard.TargetName="BorderOfButton"  Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)">
                                               
                                                    <EasingDoubleKeyFrame KeyTime="00:00:00.3000000" Value="50">
                                                        <EasingDoubleKeyFrame.EasingFunction>
                                                            <PowerEase EasingMode="EaseOut"/>
                                                        </EasingDoubleKeyFrame.EasingFunction>
                                                    </EasingDoubleKeyFrame>
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <Grid>
                                    <Border x:Name="BorderOfButton" Visibility="Collapsed" Opacity="0"  Background="{DynamicResource MWBNewTaskB}" Margin="0,0,50,0" CornerRadius="2" >
                                        <TextBlock Visibility="Visible" Text="{x:Static Language:Lang.MainPage_ADDTASK}"  Foreground="{DynamicResource MWBNewTaskText}"  Margin="20,0,20,0" FontWeight="Bold" FontStretch="Normal" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <Border.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform/>
                                                <SkewTransform/>
                                                <RotateTransform/>
                                                <TranslateTransform X="50"/>
                                            </TransformGroup>
                                        </Border.RenderTransform>
                                    </Border>
                                    <Rectangle Fill="{DynamicResource MWBNewTaskSec}" Width="40" Height="30" HorizontalAlignment="Right" RadiusX="2" RadiusY="2"></Rectangle>
                                    <Grid HorizontalAlignment="Right" Height="30"  Width="20" Margin="0,0,10,0">
                                        <Rectangle Fill="{DynamicResource MWBNewTaskRec}" RadiusX="2" RadiusY="2" Width="6" Height="20" HorizontalAlignment="Center"/>
                                        <Rectangle Fill="{DynamicResource MWBNewTaskRec}"  RadiusX="2" RadiusY="2" Width="20" Height="6" HorizontalAlignment="Center" Margin="0,7,0,7"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </ContentControl>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

    </Grid>
</UserControl>
